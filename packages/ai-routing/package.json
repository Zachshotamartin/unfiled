{
  "name": "@unfiled/ai-routing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./application": {
      "types": "./src/application.ts",
      "import": "./src/application.ts"
    },
    "./materialization": {
      "types": "./src/materialization.ts",
      "import": "./src/materialization.ts"
    },
    "./routing-rules": {
      "types": "./src/routing-rules.ts",
      "import": "./src/routing-rules.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "eval": "tsx src/evaluation/run.ts",
    "eval:pipeline": "tsx src/evaluation/run-production-pipeline.ts",
    "eval:live": "tsx src/evaluation/run-live-openai.ts",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@unfiled/contracts": "workspace:*",
    "@unfiled/domain": "workspace:*",
    "@unfiled/search": "workspace:*",
    "zod": "4.5.4"
  }
}
