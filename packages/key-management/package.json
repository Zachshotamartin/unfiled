{
  "name": "@unfiled/key-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Owner-bound production and local key custody for Unfiled encrypted content.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1121.0",
    "@unfiled/content-crypto": "workspace:*",
    "@vercel/oidc-aws-credentials-provider": "3.3.5"
  }
}
