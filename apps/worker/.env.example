# local | preview | production
UNFILED_WORKER_ENV=local

# Local and preview only: worker-local bearer, at least 32 random bytes.
# Production rejects this variable and CRON_SECRET; its invocation verifier
# must be wired to a trusted scheduler or verified invoker before drain works.
UNFILED_WORKER_DRAIN_SECRET=replace-with-at-least-32-random-characters

# Bounded request controls.
UNFILED_WORKER_MAX_REQUEST_BYTES=1024
UNFILED_WORKER_TIMEOUT_MS=45000
PORT=8788

# Production AWS KMS identity boundary. Do not add AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN, or a private-manual KMS key.
# Never add any SUPABASE-named variable or an ambient database credential such
# as DATABASE_URL, POSTGRES_URL, or PGPASSWORD. The index adapter accepts only
# its dedicated, non-bypass UNFILED_WORKER_DATABASE_URL capability.
# UNFILED_AWS_REGION=us-west-2
# UNFILED_AWS_ROLE_ARN=arn:aws:iam::123456789012:role/unfiled-worker-production
# Full, distinct key ARNs only; aliases and legacy singular IDs are rejected.
# UNFILED_AI_OBJECT_WRAP_KMS_KEY_ARN=arn:aws:kms:us-west-2:123456789012:key/11111111-2222-4333-8444-555555555555
# UNFILED_AI_CONTENT_MAC_KMS_KEY_ARN=arn:aws:kms:us-west-2:123456789012:key/66666666-7777-4888-9999-aaaaaaaaaaaa
# Optional JSON array of retained decrypt-only AI roots during/after rotation.
# Every object must have exactly arn, keyClass="ai_assisted", purpose
# ("object_wrap" or "content_mac"), and status="retired". Never include a
# staged, active, or private-manual root here. Use [] before the first rotation.
# Copy this only from:
# terraform output -raw worker_retired_ai_root_registry_json
# UNFILED_RETIRED_AI_ROOT_REGISTRY_JSON=[]
# The project segment is the exact Vercel project NAME, not its prj_ ID.
# UNFILED_WORKER_EXPECTED_OIDC_SUBJECT=owner:team-example:project:unfiled-worker:environment:production
# UNFILED_WORKER_PROJECT_ID=prj_example

# Production caller identity: the separate web project allowed in Vercel
# Deployment Protection > Trusted Sources. These values describe the caller,
# not the worker workload identity above.
# UNFILED_TRUSTED_SOURCE_TEAM_SLUG=team-example
# UNFILED_TRUSTED_SOURCE_OWNER_ID=team_owner123
# UNFILED_TRUSTED_SOURCE_WEB_PROJECT_ID=prj_webexample
# UNFILED_TRUSTED_SOURCE_WEB_PROJECT_NAME=unfiled-web
# UNFILED_TRUSTED_SOURCE_EXPECTED_OIDC_SUBJECT=owner:team-example:project:unfiled-web:environment:production

# Production encrypted-index database. The shared Supavisor pooler transport
# username is the exact role plus ".<project-ref>"; PostgreSQL must still report
# session_user/current_user as the unsuffixed role. Copy the canonical host,
# port, database, and 20-character project ref from Supabase, and retain
# sslmode=verify-full. Base64-encode the downloaded PEM bytes without editing
# them. Never use a Supabase API key, postgres/service role, IP literal, or
# rejectUnauthorized=false.
# UNFILED_WORKER_DATABASE_URL=postgresql://unfiled_index_worker.abcdefghijklmnopqrst:password@aws-0-us-west-2.pooler.supabase.com:6543/postgres?sslmode=verify-full
# UNFILED_WORKER_DATABASE_EXPECTED_HOST=aws-0-us-west-2.pooler.supabase.com
# UNFILED_WORKER_DATABASE_PROJECT_REF=abcdefghijklmnopqrst
# UNFILED_WORKER_DATABASE_CA_PEM_BASE64=<base64-of-canonical-pem-chain>
# UNFILED_WORKER_DATABASE_CONNECT_TIMEOUT_MS=3000
# UNFILED_WORKER_DATABASE_STATEMENT_TIMEOUT_MS=500

# AI-assisted retrieval embedding only. Private-manual notes cannot be claimed.
# Keep the model ID and dimension identical to the active RAG generation.
# UNFILED_OPENAI_EMBEDDING_API_KEY=<server-only-project-key>
# UNFILED_EMBEDDING_MODEL_ID=text-embedding-3-small
# UNFILED_EMBEDDING_DIMENSIONS=1536
# UNFILED_EMBEDDING_MAX_INPUT_BYTES=24576
# UNFILED_EMBEDDING_TIMEOUT_MS=10000

# Bounded lease/recovery controls. Defaults shown; claim/concurrency cannot
# exceed four, and concurrency cannot exceed the claim limit. The worker also
# rejects combinations unless the cold pool/session checks, every critical-path
# RPC (including one exact terminal replay), provider rounds, KMS allowance,
# connection allowance, and fixed slack fit inside UNFILED_WORKER_TIMEOUT_MS.
# The lease must also exceed the whole request deadline by at least 5 seconds.
# UNFILED_INDEX_CLAIM_LIMIT=2
# UNFILED_INDEX_CONCURRENCY=2
# UNFILED_INDEX_LEASE_SECONDS=120
# UNFILED_INDEX_RECOVERY_LIMIT=100
