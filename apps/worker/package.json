{
  "name": "@unfiled/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Isolated organization and encrypted-index worker for Unfiled.",
  "dependencies": {
    "@unfiled/key-management": "workspace:*",
    "@vercel/oidc": "3.8.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/server.ts",
    "lint": "eslint api src test --max-warnings=0",
    "start": "node dist/src/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
