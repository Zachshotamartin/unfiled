# local | preview | production
UNFILED_ORGANIZER_ENV=local

# In Vercel Preview/Production, enable automatic System Environment Variables.
# Vercel injects VERCEL=1, VERCEL_ENV, VERCEL_DEPLOYMENT_ID, VERCEL_GIT_COMMIT_SHA,
# and VERCEL_PROJECT_ID; never override or copy them between scopes. Managed
# startup requires them. Health responses expose only a SHA-256 deployment-ID
# digest plus the exact commit/environment, never the raw deployment ID.

# Local only. Managed runtimes reject this and CRON_SECRET.
UNFILED_ORGANIZER_DRAIN_SECRET=replace-with-at-least-32-random-characters

# Content-free request controls.
UNFILED_ORGANIZER_MAX_REQUEST_BYTES=1024
UNFILED_ORGANIZER_TIMEOUT_MS=49000
PORT=8790

# Preview/Production must select exactly one key custodian. The free private
# beta keeps a canonical root ring only in Vercel Sensitive Environment Variables.
# UNFILED_KEY_CUSTODIAN=vercel-sensitive-env-v1
# UNFILED_ORGANIZER_AI_OBJECT_WRAP_ROOT_KEY_ID=urn:unfiled:key-root:vercel-sensitive-env-v1:<preview-or-production>:<uuid>
# UNFILED_ORGANIZER_AI_CONTENT_MAC_ROOT_KEY_ID=urn:unfiled:key-root:vercel-sensitive-env-v1:<preview-or-production>:<different-uuid>
# UNFILED_ORGANIZER_RETIRED_AI_OBJECT_WRAP_ROOT_KEY_IDS_JSON=[]
# UNFILED_ORGANIZER_RETIRED_AI_CONTENT_MAC_ROOT_KEY_IDS_JSON=[]
# UNFILED_VERCEL_SENSITIVE_ENV_ROOT_KEY_RING_V1=<canonical-server-only-key-ring-json>

# AWS remains the hardened alternative. Select UNFILED_KEY_CUSTODIAN=aws-kms
# and source the following values from the matching Terraform stack. Static AWS credentials, private-manual roots,
# user-session secrets, Supabase API keys, and ambient provider keys are rejected.
# UNFILED_AWS_REGION=us-west-2
# UNFILED_AWS_ROLE_ARN=arn:aws:iam::123456789012:role/unfiled-organizer-<preview-or-production>
# UNFILED_AI_OBJECT_WRAP_KMS_KEY_ARN=arn:aws:kms:us-west-2:123456789012:key/11111111-2222-4333-8444-555555555555
# UNFILED_AI_CONTENT_MAC_KMS_KEY_ARN=arn:aws:kms:us-west-2:123456789012:key/66666666-7777-4888-8999-000000000000
# UNFILED_ORGANIZER_RETIRED_AI_OBJECT_WRAP_ROOTS_JSON=[]
# UNFILED_ORGANIZER_RETIRED_AI_CONTENT_MAC_ROOTS_JSON=[]
# UNFILED_ORGANIZER_EXPECTED_OIDC_SUBJECT=owner:team-example:project:unfiled-organizer:environment:<preview-or-production>
# UNFILED_ORGANIZER_PROJECT_ID=prj_organizerexample

# Exact same-environment web caller accepted through Vercel Trusted Sources.
# UNFILED_TRUSTED_SOURCE_TEAM_SLUG=team-example
# UNFILED_TRUSTED_SOURCE_OWNER_ID=team_owner123
# UNFILED_TRUSTED_SOURCE_WEB_PROJECT_ID=prj_webexample
# UNFILED_TRUSTED_SOURCE_WEB_PROJECT_NAME=unfiled-web
# UNFILED_TRUSTED_SOURCE_EXPECTED_OIDC_SUBJECT=owner:team-example:project:unfiled-web:environment:<preview-or-production>

# Dedicated RPC-only PostgreSQL login in the one approved remote private-beta
# database. The free beta deploys Production only (Preview builds are skipped);
# any later Preview scope would share this database and is not isolation. PostgreSQL must report both session_user
# and current_user as exactly unfiled_organizer_worker. Keep verify-full TLS.
# UNFILED_ORGANIZER_DATABASE_URL=postgresql://unfiled_organizer_worker.abcdefghijklmnopqrst:password@aws-0-us-west-2.pooler.supabase.com:6543/postgres?sslmode=verify-full
# UNFILED_ORGANIZER_DATABASE_EXPECTED_HOST=aws-0-us-west-2.pooler.supabase.com
# UNFILED_ORGANIZER_DATABASE_PROJECT_REF=abcdefghijklmnopqrst
# UNFILED_ORGANIZER_DATABASE_CA_PEM_BASE64=<base64-of-canonical-pem-chain>
# UNFILED_ORGANIZER_DATABASE_CONNECT_TIMEOUT_MS=3000
# UNFILED_ORGANIZER_DATABASE_STATEMENT_TIMEOUT_MS=1500

# Bounded queue controls. Candidate retrieval is fixed at no more than eight
# authorized encrypted aggregates by the app/shared-plan boundary.
# UNFILED_ORGANIZER_CLAIM_LIMIT=2
# UNFILED_ORGANIZER_CONCURRENCY=2
# UNFILED_ORGANIZER_LEASE_SECONDS=120
# UNFILED_ORGANIZER_RECOVERY_LIMIT=100

# Retrieval embeddings must be explicit. The free beta uses the pinned local
# hash generation and makes no external embedding request.
# UNFILED_ORGANIZER_EMBEDDING_PROVIDER=local-hash-v1
# OpenAI embedding alternative: UNFILED_ORGANIZER_EMBEDDING_PROVIDER=openai

# Preview/Production routing is bring-your-own-key first. Each job's immutable
# snapshot names its provider (openai | anthropic), its exact
# organization-model-registry-v2 model, and its effort; the organizer resolves
# the matching user credential from Supabase Vault under the live job lease.
# The free private beta sets NO operator provider key: app-default jobs then
# fail closed to Inbox and the user is asked to add a key in Settings.
#
# OPTIONAL: an environment-specific OpenAI project/service-account key funds
# app-default routing and explicitly snapshotted fallback for OpenAI only.
# There is no app-funded Claude credential. Endpoints, prompt, schema, effort
# mapping, deadline, and retry policy are pinned in code.
# UNFILED_ORGANIZER_OPENAI_API_KEY=replace-with-dedicated-project-key

# Do not set OPENAI_API_KEY, UNFILED_OPENAI_API_KEY, ANTHROPIC_API_KEY,
# UNFILED_ORGANIZER_ANTHROPIC_API_KEY, a model or base-URL override, a user BYOK
# key, or any other provider credential here; startup rejects them.
