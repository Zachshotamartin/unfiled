# local | preview | production
UNFILED_ORGANIZER_ENV=local

# Local and preview only. Production rejects this and CRON_SECRET.
UNFILED_ORGANIZER_DRAIN_SECRET=replace-with-at-least-32-random-characters

# Content-free request controls.
UNFILED_ORGANIZER_MAX_REQUEST_BYTES=1024
UNFILED_ORGANIZER_TIMEOUT_MS=49000
PORT=8790

# Production workload identity. Static AWS credentials, private-manual roots,
# user-session secrets, Supabase API keys, and model-provider keys are rejected.
# UNFILED_AWS_REGION=us-west-2
# UNFILED_AWS_ROLE_ARN=arn:aws:iam::123456789012:role/unfiled-organizer-production
# UNFILED_AI_OBJECT_WRAP_KMS_KEY_ARN=arn:aws:kms:us-west-2:123456789012:key/11111111-2222-4333-8444-555555555555
# UNFILED_AI_CONTENT_MAC_KMS_KEY_ARN=arn:aws:kms:us-west-2:123456789012:key/66666666-7777-4888-8999-000000000000
# UNFILED_ORGANIZER_RETIRED_AI_OBJECT_WRAP_ROOTS_JSON=[]
# UNFILED_ORGANIZER_RETIRED_AI_CONTENT_MAC_ROOTS_JSON=[]
# UNFILED_ORGANIZER_EXPECTED_OIDC_SUBJECT=owner:team-example:project:unfiled-organizer:environment:production
# UNFILED_ORGANIZER_PROJECT_ID=prj_organizerexample

# Exact production web caller accepted through Vercel Trusted Sources.
# UNFILED_TRUSTED_SOURCE_TEAM_SLUG=team-example
# UNFILED_TRUSTED_SOURCE_OWNER_ID=team_owner123
# UNFILED_TRUSTED_SOURCE_WEB_PROJECT_ID=prj_webexample
# UNFILED_TRUSTED_SOURCE_WEB_PROJECT_NAME=unfiled-web
# UNFILED_TRUSTED_SOURCE_EXPECTED_OIDC_SUBJECT=owner:team-example:project:unfiled-web:environment:production

# Dedicated RPC-only PostgreSQL login. PostgreSQL must report both session_user
# and current_user as exactly unfiled_organizer_worker. Keep verify-full TLS.
# UNFILED_ORGANIZER_DATABASE_URL=postgresql://unfiled_organizer_worker.abcdefghijklmnopqrst:password@aws-0-us-west-2.pooler.supabase.com:6543/postgres?sslmode=verify-full
# UNFILED_ORGANIZER_DATABASE_EXPECTED_HOST=aws-0-us-west-2.pooler.supabase.com
# UNFILED_ORGANIZER_DATABASE_PROJECT_REF=abcdefghijklmnopqrst
# UNFILED_ORGANIZER_DATABASE_CA_PEM_BASE64=<base64-of-canonical-pem-chain>
# UNFILED_ORGANIZER_DATABASE_CONNECT_TIMEOUT_MS=3000
# UNFILED_ORGANIZER_DATABASE_STATEMENT_TIMEOUT_MS=1500

# Bounded queue controls. Candidate retrieval is fixed at no more than eight
# authorized encrypted aggregates by the app/shared-plan boundary.
# UNFILED_ORGANIZER_CLAIM_LIMIT=2
# UNFILED_ORGANIZER_CONCURRENCY=2
# UNFILED_ORGANIZER_LEASE_SECONDS=120
# UNFILED_ORGANIZER_RECOVERY_LIMIT=100

# Milestone D owns provider/scoring/personalization configuration. Do not set
# OPENAI_API_KEY, ANTHROPIC_API_KEY, or an UNFILED_* model API key here.
