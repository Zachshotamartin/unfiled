# local | preview | production
UNFILED_VERIFIER_ENV=local

# Bounded HTTP controls. Local and Preview expose health only; verification is
# deliberately disabled and every Production capability below is rejected.
UNFILED_VERIFIER_MAX_REQUEST_BYTES=1024
UNFILED_VERIFIER_TIMEOUT_MS=49000
PORT=8789

# Production workload identity and the one active AI-assisted object-wrap root.
# Vercel injects VERCEL_ENV and VERCEL_PROJECT_ID; do not set them by hand.
# Never add static AWS credentials, an AI content-MAC root, a private-manual
# root, a model/provider credential, or any user-session credential.
# UNFILED_AWS_REGION=<aws-region>
# UNFILED_AWS_ROLE_ARN=<terraform-verifier-role-arn>
# UNFILED_AI_OBJECT_WRAP_KMS_KEY_ARN=<terraform-active-ai-object-wrap-key-arn>
# Copy this value verbatim from:
# terraform output -raw verifier_retired_ai_object_wrap_roots_json
# UNFILED_RETIRED_AI_OBJECT_WRAP_ROOTS_JSON=<terraform-verifier-retired-output>
# The subject project segment is the exact Vercel project name, not its prj_ ID.
# UNFILED_VERIFIER_EXPECTED_OIDC_SUBJECT=<terraform-verifier-oidc-subject>
# UNFILED_VERIFIER_PROJECT_ID=<verifier-vercel-project-id>

# Production caller identity. These values describe the separate web project
# admitted by Vercel Deployment Protection Trusted Sources.
# UNFILED_TRUSTED_SOURCE_TEAM_SLUG=<exact-vercel-team-slug>
# UNFILED_TRUSTED_SOURCE_OWNER_ID=<exact-vercel-team-id>
# UNFILED_TRUSTED_SOURCE_WEB_PROJECT_ID=<web-vercel-project-id>
# UNFILED_TRUSTED_SOURCE_WEB_PROJECT_NAME=<exact-web-project-name>
# UNFILED_TRUSTED_SOURCE_EXPECTED_OIDC_SUBJECT=<terraform-web-oidc-subject>

# Dedicated verifier database login. The shared Supavisor transport username is
# unfiled_rag_verifier.<project-ref>; PostgreSQL must report both session_user
# and current_user as unfiled_rag_verifier. Keep sslmode=verify-full. Never use
# postgres, service_role, a Supabase API key, an IP literal, DATABASE_URL, or the
# index-worker credential. Base64-encode the downloaded canonical CA PEM bytes.
# UNFILED_VERIFIER_DATABASE_URL=<exact-verifier-postgresql-uri>
# UNFILED_VERIFIER_DATABASE_EXPECTED_HOST=<exact-canonical-database-host>
# UNFILED_VERIFIER_DATABASE_PROJECT_REF=<exact-20-character-project-ref>
# UNFILED_VERIFIER_DATABASE_CA_PEM_BASE64=<base64-of-canonical-ca-pem>

# Optional bounded Production controls. The configuration rejects combinations
# whose explicit statement/cancel/connect/four-serial-KMS/in-process/headroom
# budget cannot fit inside the deadline. The in-process allowance scales up when
# decrypt concurrency is lowered. Row/page capacity is fixed at 1,000 notes and
# distinct object-wrap key-record cardinality is fixed at 4; neither has an
# environment override.
# UNFILED_VERIFIER_DECRYPT_CONCURRENCY=8
# UNFILED_VERIFIER_DATABASE_CONNECT_TIMEOUT_MS=2000
# UNFILED_VERIFIER_DATABASE_STATEMENT_TIMEOUT_MS=250
# UNFILED_VERIFIER_KMS_TIMEOUT_MS=2000
