# Public Supabase project settings used by the browser-compatible auth and REST adapters.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Required for the OTP quota and owner-bound capture storage RPCs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
AUTH_RATE_LIMIT_PEPPER=replace-with-a-long-random-secret

# Server-only encrypted-content keys. The current environment-backed resolver is for local
# development and isolated preview data only. Generate independent 32-byte base64url values;
# never reuse the wrapping key as the fingerprint key and never commit real keys.
UNFILED_CONTENT_KEK_ID=preview-content-kek-v1
UNFILED_CONTENT_KEK=replace-with-32-random-bytes-as-base64url
UNFILED_CONTENT_FINGERPRINT_KEY=replace-with-a-different-32-byte-base64url-key

# Keep the fingerprint key stable across normal KEK rotations. Rotating it requires an audited
# decrypt-and-re-fingerprint migration for every existing capture before traffic switches.

# Optional JSON map used only while old envelopes are being rewrapped. Remove retired keys after
# a verified rotation and backup-restore drill. Example: {"preview-content-kek-v0":"base64url"}
# UNFILED_CONTENT_RETIRED_KEKS={}

# Production uses Vercel OIDC and four AWS KMS root families. Scope all three settings to the
# Vercel Production environment only; never add them to a NEXT_PUBLIC variable. Copy the role and
# region from the Terraform web outputs. Serialize the complete active/staged/retired registry with
# `terraform output -json web_root_key_registry` and keep it in this one server-only setting.
# UNFILED_AWS_REGION=us-west-2
# UNFILED_AWS_ROLE_ARN=arn:aws:iam::123456789012:role/unfiled-production-web
# UNFILED_WEB_ROOT_KEY_REGISTRY_JSON=<single-line Terraform web_root_key_registry JSON>

# The managed-key resolver's local/test mode uses an owner-bound local key ring. Never set these in
# Vercel or production, and never commit real key material.
# UNFILED_KEY_CUSTODIAN=local
# UNFILED_LOCAL_KEY_RING_V1=<local development key-ring JSON>

# Server-only Vercel Cron authentication. Retention remains dry-run until a human explicitly
# enables execution after reviewing the first scheduled result.
CRON_SECRET=replace-with-at-least-32-random-characters
NOTE_RETENTION_EXECUTION_ENABLED=false

# Local development only. Never set this in a production deployment.
# UNFILED_WEB_DATA_ADAPTER=memory
