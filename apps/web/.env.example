# Public Supabase project settings used by the browser-compatible auth and REST adapters.
# The free private beta deploys the Vercel Production scope only (Preview builds are
# skipped) against one approved remote Supabase project; local Supabase remains
# Development. Any later Preview scope would share that data and is not isolation.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# In Vercel Preview/Production, enable automatic System Environment Variables.
# Vercel injects VERCEL=1, VERCEL_ENV, VERCEL_DEPLOYMENT_ID, and
# VERCEL_GIT_COMMIT_SHA; never override them. /api/health fails closed if they
# are incomplete and exposes only the deployment-ID SHA-256 digest, exact
# lowercase commit, and exact environment—not the raw deployment ID.

# Server-only. Required for the OTP quota and owner-bound capture storage RPCs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical public origin (https, no trailing slash). Production uses the exact
# Vercel production alias until a cleared custom domain exists.
NEXT_PUBLIC_SITE_URL=https://unfiled-web.vercel.app
AUTH_RATE_LIMIT_PEPPER=replace-with-a-long-random-secret

# Server-only. Independent >=32-character HMAC pepper for unauthenticated deletion-receipt
# replay throttling. Never reuse the auth pepper or any cursor, content, provider, Supabase, or cron secret.
ACCOUNT_DELETION_REPLAY_RATE_LIMIT_PEPPER=replace-with-a-different-long-random-secret

# Server-only. Independent 32-byte base64url HMAC key for randomized private-search cursors.
# Never expose this through NEXT_PUBLIC_* or reuse a content, auth, provider, or cron key.
UNFILED_PRIVATE_SEARCH_CURSOR_HMAC_KEY=replace-with-32-random-bytes-as-base64url

# Legacy environment-backed encrypted-content keys. These are not accepted by the managed key
# runtime in either Vercel Preview or Production. Keep them only for isolated legacy/local tooling;
# never reuse the wrapping key as the fingerprint key and never commit real keys.
UNFILED_CONTENT_KEK_ID=preview-content-kek-v1
UNFILED_CONTENT_KEK=replace-with-32-random-bytes-as-base64url
UNFILED_CONTENT_FINGERPRINT_KEY=replace-with-a-different-32-byte-base64url-key

# Keep the fingerprint key stable across normal KEK rotations. Rotating it requires an audited
# decrypt-and-re-fingerprint migration for every existing capture before traffic switches.

# Optional JSON map used only while old envelopes are being rewrapped. Remove retired keys after
# a verified rotation and backup-restore drill. Example: {"preview-content-kek-v0":"base64url"}
# UNFILED_CONTENT_RETIRED_KEKS={}

# Deferred AWS path (not used by the free beta): Vercel OIDC and four AWS KMS root families. Leave
# UNFILED_KEY_CUSTODIAN unset only for this mode. Scope each environment's three settings to that environment only;
# never add them to a NEXT_PUBLIC variable. Copy the role, region, and complete
# active/staged/retired registry from that environment's separate Terraform state. Never copy
# Preview values into Production or Production values into Preview.
# UNFILED_AWS_REGION=us-west-2
# UNFILED_AWS_ROLE_ARN=arn:aws:iam::123456789012:role/unfiled-<preview-or-production>-web
# UNFILED_WEB_ROOT_KEY_REGISTRY_JSON=<single-line Terraform web_root_key_registry JSON>

# $0 private-beta managed path: set these three variables in the Vercel Production scope only.
# Preview is intentionally denied this custodian because the beta uses one shared remote database;
# it must not race Production for an environment-bound active key. VERCEL_PROJECT_ID and
# VERCEL_ENV are system variables and are matched exactly against both documents. Do not set any
# UNFILED_AWS_*, AWS credential, legacy/local key, or NEXT_PUBLIC_* key variable alongside this
# mode. Each root keyMaterial is an independently generated 32-byte base64url value. Both JSON
# documents must be compact canonical JSON produced by JSON.stringify, with no whitespace or
# duplicate properties. The metadata registry contains no key material.
# UNFILED_KEY_CUSTODIAN=vercel-sensitive-env-v1
# UNFILED_WEB_ROOT_KEY_REGISTRY_V2_JSON={"version":2,"custodyProvider":"vercel_sensitive_environment_v1","projectId":"prj_EXACT_VERCEL_PROJECT_ID","deploymentEnvironment":"production","roots":{"ai_assisted_object_wrap_v1":{"generation":1,"keyClass":"ai_assisted","purpose":"object_wrap","rootKeyId":"urn:unfiled:key-root:vercel-sensitive-env-v1:production:11111111-1111-4111-8111-111111111111","status":"active"},"ai_assisted_content_mac_v1":{"generation":1,"keyClass":"ai_assisted","purpose":"content_mac","rootKeyId":"urn:unfiled:key-root:vercel-sensitive-env-v1:production:22222222-2222-4222-8222-222222222222","status":"active"},"private_manual_object_wrap_v1":{"generation":1,"keyClass":"private_manual","purpose":"object_wrap","rootKeyId":"urn:unfiled:key-root:vercel-sensitive-env-v1:production:33333333-3333-4333-8333-333333333333","status":"active"},"private_manual_content_mac_v1":{"generation":1,"keyClass":"private_manual","purpose":"content_mac","rootKeyId":"urn:unfiled:key-root:vercel-sensitive-env-v1:production:44444444-4444-4444-8444-444444444444","status":"active"}}}
# UNFILED_VERCEL_SENSITIVE_ENV_ROOT_KEY_RING_V1={"deploymentEnvironment":"production","projectId":"prj_EXACT_VERCEL_PROJECT_ID","roots":[{"keyMaterial":"<32-byte-base64url-root-1>","rootKeyId":"urn:unfiled:key-root:vercel-sensitive-env-v1:production:11111111-1111-4111-8111-111111111111"},{"keyMaterial":"<32-byte-base64url-root-2>","rootKeyId":"urn:unfiled:key-root:vercel-sensitive-env-v1:production:22222222-2222-4222-8222-222222222222"},{"keyMaterial":"<32-byte-base64url-root-3>","rootKeyId":"urn:unfiled:key-root:vercel-sensitive-env-v1:production:33333333-3333-4333-8333-333333333333"},{"keyMaterial":"<32-byte-base64url-root-4>","rootKeyId":"urn:unfiled:key-root:vercel-sensitive-env-v1:production:44444444-4444-4444-8444-444444444444"}],"version":1}
# After the V2 database migration is applied and these values are set, redeploy Production. The
# first authenticated owner operation atomically generates, registers with
# register_user_content_key_v2, proves, and activates four owner-bound intermediate keys.

# The managed-key resolver's local/test mode uses an owner-bound local key ring. Never set these in
# Vercel or production, and never commit real key material.
# UNFILED_KEY_CUSTODIAN=local
# UNFILED_LOCAL_KEY_RING_V1=<local development key-ring JSON>

# Server-only Vercel Cron authentication. Retention remains dry-run until a human explicitly
# enables execution after reviewing the first scheduled result.
CRON_SECRET=replace-with-at-least-32-random-characters
NOTE_RETENTION_EXECUTION_ENABLED=false

# Managed-cloud cross-project encrypted-index worker. This exact path-free
# HTTPS *.vercel.app origin is a sensitive OIDC-token egress trust boundary.
# Before setting it, use Vercel's authenticated management plane to prove the
# alias belongs to the intended worker deployment (see HUMAN_SETUP.md). The
# explicit target marker must exactly match VERCEL_ENV.
# Runtime code cannot infer a Vercel project ID from an alias. The caller sends
# only a short-lived Vercel OIDC token and a content-free drain trigger.
# UNFILED_INDEX_WORKER_ORIGIN=https://unfiled-worker.vercel.app
# UNFILED_WORKER_ENV=production

# Managed-cloud isolated encrypted organizer. Prove this exact path-free
# HTTPS *.vercel.app alias belongs to the intended same-environment organizer deployment
# before configuring it. The web project forwards only a short-lived Vercel OIDC
# token and a content-free drain trigger; capture/note content is never placed in
# the request. The organizer expires internally before the 54-second web caller.
# UNFILED_ORGANIZER_ORIGIN=https://unfiled-organizer.vercel.app
# UNFILED_ORGANIZER_ENV=production

# Managed-cloud independent encrypted-index verifier. Prove this exact
# path-free HTTPS *.vercel.app alias belongs to the intended same-environment verifier
# project before configuring it. It must differ from the worker origin. The fixed
# 54-second caller deadline leaves headroom above the verifier's 49-second
# deadline and below the maintenance handler's 55-second deadline.
# UNFILED_RAG_VERIFIER_ORIGIN=https://unfiled-verifier.vercel.app
# UNFILED_VERIFIER_ENV=production

# Isolated encrypted user-search trust domain. Configure the exact, path-free
# HTTPS *.vercel.app alias for the search deployment in the same Vercel
# environment as web. The explicit target marker must equal VERCEL_ENV so a
# Preview caller cannot silently send query material to Production (or the
# reverse). Web sends only a one-use database ticket, claim secret, canonical
# AI-assisted search material, and its digest with a short-lived OIDC token.
# UNFILED_SEARCH_ENV=production
# UNFILED_SEARCH_ORIGIN=https://unfiled-search.vercel.app

# The web lifecycle controller and index worker must use the identical model
# target. These settings identify the shadow generation; the web project must
# never receive the embedding-provider API key.
# The free beta pins the provider-neutral local hash generation.
# UNFILED_EMBEDDING_MODEL_ID=unfiled-local-hash-v1
# UNFILED_EMBEDDING_DIMENSIONS=512
# OpenAI alternative (deferred): text-embedding-3-small / 1536

# Local development only. Never set this in a production deployment.
# UNFILED_WEB_DATA_ADAPTER=memory

# Server-only deployment capability flag for app-funded (managed) AI fallback. Leave unset on the
# free private beta. Set to exactly 1 or true only where the organizer is configured with
# UNFILED_ORGANIZER_OPENAI_API_KEY; the settings UI hides managed fallback otherwise.
# UNFILED_MANAGED_AI_FALLBACK_AVAILABLE=1
