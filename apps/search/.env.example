# Set exactly one deployment scope. Local is health/surface testing only and
# deliberately has no database, provider, or KMS search pipeline.
UNFILED_SEARCH_ENV=local
UNFILED_SEARCH_INVOCATION_SECRET=replace-with-at-least-32-random-non-whitespace-characters

# Vercel Preview/Production: use the matching, separately provisioned values.
# Enable automatic System Environment Variables. Vercel injects VERCEL=1,
# VERCEL_ENV, VERCEL_DEPLOYMENT_ID, VERCEL_GIT_COMMIT_SHA, and VERCEL_PROJECT_ID;
# never override or copy them between scopes. Managed startup requires them.
# Health responses expose only a SHA-256 deployment-ID digest plus the exact
# commit/environment, never the raw deployment ID.
# Choose exactly one managed key custodian. The free private beta uses the
# server-only Vercel sensitive-environment ring; AWS remains supported.
# UNFILED_KEY_CUSTODIAN=vercel-sensitive-env-v1
# UNFILED_SEARCH_AI_OBJECT_WRAP_ROOT_KEY_ID=urn:unfiled:key-root:vercel-sensitive-env-v1:<preview-or-production>:<uuid>
# UNFILED_SEARCH_RETIRED_AI_OBJECT_WRAP_ROOT_KEY_IDS_JSON=[]
# UNFILED_VERCEL_SENSITIVE_ENV_ROOT_KEY_RING_V1=<canonical-server-only-key-ring-json>
# AWS alternative: UNFILED_KEY_CUSTODIAN=aws-kms
# UNFILED_SEARCH_PROJECT_TEAM_SLUG=your-vercel-team-slug
# UNFILED_SEARCH_PROJECT_NAME=unfiled-search
# UNFILED_SEARCH_PROJECT_ID=prj_replace
# UNFILED_SEARCH_EXPECTED_OIDC_SUBJECT=owner:team:project:unfiled-search:environment:<preview-or-production>
# UNFILED_AWS_REGION=us-west-2
# UNFILED_SEARCH_AWS_ROLE_ARN=arn:aws:iam::123456789012:role/unfiled-<preview-or-production>-search
# UNFILED_SEARCH_AI_OBJECT_WRAP_KMS_KEY_ARN=arn:aws:kms:us-west-2:123456789012:key/00000000-0000-4000-8000-000000000000
# UNFILED_SEARCH_RETIRED_AI_OBJECT_WRAP_ROOTS_JSON=[]

# Exact interactive-web Trusted Source allowed to call /internal/query.
# UNFILED_SEARCH_TRUSTED_SOURCE_TEAM_SLUG=your-vercel-team-slug
# UNFILED_SEARCH_TRUSTED_SOURCE_OWNER_ID=team_replace
# UNFILED_SEARCH_TRUSTED_SOURCE_WEB_PROJECT_ID=prj_replace
# UNFILED_SEARCH_TRUSTED_SOURCE_WEB_PROJECT_NAME=unfiled-web
# UNFILED_SEARCH_TRUSTED_SOURCE_EXPECTED_OIDC_SUBJECT=owner:team:project:unfiled-web:environment:<preview-or-production>

# The free beta performs query embedding locally with the same pinned profile as
# the active index generation and needs no provider key.
# UNFILED_SEARCH_EMBEDDING_PROVIDER=local-hash-v1
# OpenAI alternative (requires the dedicated key below):
# UNFILED_SEARCH_EMBEDDING_PROVIDER=openai
# UNFILED_SEARCH_OPENAI_API_KEY=set-in-vercel-secret-storage

# Dedicated TLS-only LOGIN role in the one approved remote private-beta database,
# provisioned explicitly with NOINHERIT and NOBYPASSRLS. The free beta deploys
# Production only (Preview builds are skipped); any later Preview scope would
# share this database and role and is not isolation.
# UNFILED_SEARCH_DATABASE_PROJECT_REF=replacewith20chars
# UNFILED_SEARCH_DATABASE_EXPECTED_HOST=aws-0-us-west-2.pooler.supabase.com
# UNFILED_SEARCH_DATABASE_URL=postgresql://unfiled_search_worker.PROJECT_REF:PASSWORD@HOST:6543/postgres?sslmode=verify-full
# UNFILED_SEARCH_DATABASE_CA_PEM_BASE64=set-in-vercel-secret-storage

# Optional bounded operational tuning.
# UNFILED_SEARCH_MAX_REQUEST_BYTES=16384
# UNFILED_SEARCH_TIMEOUT_MS=25000
# UNFILED_SEARCH_DATABASE_CONNECT_TIMEOUT_MS=3000
# UNFILED_SEARCH_DATABASE_STATEMENT_TIMEOUT_MS=2000
