{
  "name": "unfiled",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Capture-first notes that organize after you write.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "pnpm": {
    "overrides": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "build": "turbo run build --filter=@unfiled/web --filter=@unfiled/worker --filter=@unfiled/verifier --filter='./packages/*'",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:built-servers && pnpm check:boundaries && pnpm check:openapi",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "check:openapi": "tsx scripts/generate-openapi.ts --check",
    "db:reset": "supabase db reset --local",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "dev": "turbo run dev --parallel --filter=@unfiled/web --filter=@unfiled/worker --filter=@unfiled/verifier --filter='./packages/*'",
    "eval:routing": "pnpm --filter @unfiled/ai-routing eval",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "ios:build": "bash .github/workflows/scripts/ios-xcode.sh build",
    "ios:ci": "bash .github/workflows/scripts/ios-xcode.sh ci",
    "ios:generate": "bash .github/workflows/scripts/ios-xcode.sh generate",
    "ios:inspect": "bash .github/workflows/scripts/ios-xcode.sh inspect",
    "ios:resolve": "bash .github/workflows/scripts/ios-xcode.sh resolve",
    "ios:test": "bash .github/workflows/scripts/ios-xcode.sh test",
    "lint": "turbo run lint --filter=@unfiled/web --filter=@unfiled/worker --filter=@unfiled/verifier --filter='./packages/*'",
    "test": "turbo run test --filter=@unfiled/web --filter=@unfiled/worker --filter=@unfiled/verifier --filter='./packages/*'",
    "test:built-servers": "pnpm --filter @unfiled/worker --filter @unfiled/verifier build && pnpm --filter @unfiled/worker --filter @unfiled/verifier test:built-server",
    "test:coverage": "turbo run test:coverage --filter=@unfiled/web --filter=@unfiled/worker --filter=@unfiled/verifier --filter='./packages/*'",
    "test:db": "supabase test db",
    "typecheck": "turbo run typecheck --filter=@unfiled/web --filter=@unfiled/worker --filter=@unfiled/verifier --filter='./packages/*'"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "supabase": "2.116.0",
    "tsx": "4.23.13",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
