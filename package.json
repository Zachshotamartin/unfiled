{
  "name": "unfiled",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Capture-first notes that organize after you write.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "pnpm": {
    "overrides": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "audit:production": "pnpm audit --prod --audit-level high",
    "build": "turbo run build --filter=@unfiled/web --filter=@unfiled/worker --filter=@unfiled/verifier --filter=@unfiled/organizer --filter=@unfiled/search-service --filter='./packages/*'",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:built-servers && pnpm check:boundaries && pnpm check:openapi && pnpm check:release-probe && pnpm test:live-gate-checks && pnpm demo:seed:check",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "check:openapi": "tsx scripts/generate-openapi.ts --check",
    "check:release-probe": "pnpm lint:release-probe && pnpm typecheck:release-probe && pnpm test:release-probe",
    "db:reset": "supabase db reset --local",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "demo:seed": "tsx scripts/demo/seed.ts",
    "demo:seed:check": "pnpm demo:seed:lint && pnpm demo:seed:typecheck && pnpm demo:seed:test",
    "demo:seed:lint": "eslint scripts/demo",
    "demo:seed:test": "vitest run scripts/demo/seed-core.test.ts",
    "demo:seed:typecheck": "tsc --noEmit -p scripts/demo/tsconfig.json",
    "dev": "turbo run dev --parallel --filter=@unfiled/web --filter=@unfiled/worker --filter=@unfiled/verifier --filter=@unfiled/organizer --filter=@unfiled/search-service --filter='./packages/*'",
    "eval:routing": "pnpm --filter @unfiled/ai-routing eval",
    "eval:routing:live": "pnpm --filter @unfiled/ai-routing eval:live",
    "eval:routing:live:anthropic": "pnpm --filter @unfiled/ai-routing eval:live:anthropic",
    "eval:routing:pipeline": "pnpm --filter @unfiled/ai-routing eval:pipeline",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "ios:archive-preflight": "bash .github/workflows/scripts/ios-release-evidence.sh archive-preflight",
    "ios:build": "bash .github/workflows/scripts/ios-xcode.sh build",
    "ios:ci": "bash .github/workflows/scripts/ios-xcode.sh ci",
    "ios:generate": "bash .github/workflows/scripts/ios-xcode.sh generate",
    "ios:inspect": "bash .github/workflows/scripts/ios-xcode.sh inspect",
    "ios:inspect-signed": "bash .github/workflows/scripts/ios-release-evidence.sh inspect-signed",
    "ios:resolve": "bash .github/workflows/scripts/ios-xcode.sh resolve",
    "ios:test": "bash .github/workflows/scripts/ios-xcode.sh test",
    "lint": "turbo run lint --filter=@unfiled/web --filter=@unfiled/worker --filter=@unfiled/verifier --filter=@unfiled/organizer --filter=@unfiled/search-service --filter='./packages/*'",
    "lint:release-probe": "eslint scripts/operations/deployed-release-probe*.ts",
    "release:probe": "tsx scripts/operations/deployed-release-probe-cli.ts",
    "test": "turbo run test --filter=@unfiled/web --filter=@unfiled/worker --filter=@unfiled/verifier --filter=@unfiled/organizer --filter=@unfiled/search-service --filter='./packages/*'",
    "test:built-servers": "pnpm --filter @unfiled/worker --filter @unfiled/verifier --filter @unfiled/organizer --filter @unfiled/search-service build && pnpm --filter @unfiled/worker --filter @unfiled/verifier --filter @unfiled/organizer --filter @unfiled/search-service test:built-server",
    "test:coverage": "turbo run test:coverage --filter=@unfiled/web --filter=@unfiled/worker --filter=@unfiled/verifier --filter=@unfiled/organizer --filter=@unfiled/search-service --filter='./packages/*'",
    "test:db": "supabase test db",
    "test:db:concurrency": "pnpm --filter @unfiled/organizer test:lock-order && pnpm --filter @unfiled/organizer test:storage-contract-concurrency && pnpm --filter @unfiled/search-service test:capability-concurrency",
    "test:http:e2e": "bash .github/workflows/scripts/milestone-b-http-e2e.sh",
    "test:live-gate-checks": "vitest run scripts/operations/live-gate/gate-checks.test.mjs",
    "test:retrieval-capacity": "pnpm --filter @unfiled/organizer test:retrieval-capacity",
    "test:release-probe": "vitest run scripts/operations/deployed-release-probe.test.ts",
    "test:search-capacity": "pnpm --filter @unfiled/search-service test:capacity",
    "test:search-trust-domain": "bash .github/workflows/scripts/milestone-f-search-trust-domain.sh",
    "typecheck": "turbo run typecheck --filter=@unfiled/web --filter=@unfiled/worker --filter=@unfiled/verifier --filter=@unfiled/organizer --filter=@unfiled/search-service --filter='./packages/*'",
    "typecheck:release-probe": "tsc --noEmit -p scripts/operations/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "supabase": "2.116.0",
    "tsx": "4.23.13",
    "turbo": "2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
